{
  "anvil-manifest-sync": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/post_tool_sync.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
